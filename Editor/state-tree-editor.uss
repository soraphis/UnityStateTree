VisualElement.state-tree-root {
    margin-left: -13px;
    padding: 0;
}

.state-tree-root ScrollView {
    padding-left: 12px;
    padding-top: 12px;
    flex-grow: 1;
}

.state-tree-root {
    padding: 6px;
}

.state-tree-toolbar {
    margin-bottom: 6px;
}

.state-list {
    max-height: 400px;
}

.state-row {
    display: flex;
    align-items: flex-start;
    margin-bottom: 2px;
}

.state-box {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #555;
    border-right-color: #555;
    border-top-color: #555;
    border-bottom-color: #555;
    padding: 4px 8px;
    background-color: #222;
    color: #eee;
}


.selection-box {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.selection-box.selected {
    background-color: #2b60a8;
    border-left-color: #4ea0ff;
    border-right-color: #4ea0ff;
    border-top-color: #4ea0ff;
    border-bottom-color: #4ea0ff;
}

.detail-drawer {
    margin-top: 6px;
    padding: 8px;
    border-top-width: 1px;
    border-top-color: #444;
    min-height: 80px;
    background-color: #2a2a2a;
}

/* inspector-like box for native feel */
.inspector-box {
    padding: 8px;
    background-color: #2a2a2a;
    border-top-width: 1px;
    border-top-color: #333;
}

.help-box {
    padding: 6px;
    background-color: #2b2b2b;
    border-left-width: 3px;
    border-left-color: #3b3b3b;
}

.state-box.selector-state{
    background-color: #663399;
    border-left-color: #572588;
    border-right-color: #572588;
    border-top-color: #572588;
    border-bottom-color: #572588;
}


/* ── Conditions chips ───────────────────────────────────────────────── */
.conditions-box {
    margin-left: 6px;
}

.condition-chip {
    background-color: #af6b01;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #c37e08;
    border-right-color: #c37e08;
    border-top-color: #c37e08;
    border-bottom-color: #c37e08;
    color: #ffffff;
    padding: 1px 5px;
    margin-right: 3px;
    font-size: 10px;
}

/* ── Tasks row ──────────────────────────────────────────────────────── */
.tasks-row {
    margin-top: 0;
    margin-bottom: 2px;
}

.task-chip {
    background-color: #1a2a3a;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #2a5a8a;
    border-right-color: #2a5a8a;
    border-top-color: #2a5a8a;
    border-bottom-color: #2a5a8a;
    color: #7ab8e8;
    padding: 1px 5px;
    margin-right: 3px;
    font-size: 10px;
}

/* ── Transitions row ────────────────────────────────────────────────── */
.transitions-row {
    margin-top: 0;
    margin-bottom: 2px;
}

.transition-chip {
    background-color: #2a1a1a;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #7a2a2a;
    border-right-color: #7a2a2a;
    border-top-color: #7a2a2a;
    border-bottom-color: #7a2a2a;
    color: #e87a7a;
    padding: 1px 5px;
    margin-right: 3px;
    font-size: 10px;
}

