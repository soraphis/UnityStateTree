/* ── ArrayDrawer-style list field ───────────────────────────────────── */
.list-field-container {
    margin-top: 6px;
    margin-bottom: 2px;
    border-top-width: 1px;
    border-top-color: #3a3a3a;
}

.list-field-header {
    background-color: #323232;
    padding: 3px 4px;
    border-bottom-width: 1px;
    border-bottom-color: #3a3a3a;
}

.list-foldout {
    width: 14px;
    color: #aaa;
    -unity-text-align: middle-center;
    cursor: link;
}

.list-field-title {
    color: #ccc;
    margin-left: 4px;
    -unity-font-style: bold;
    font-size: 11px;
    cursor: link;
}

.list-count-badge {
    color: #777;
    font-size: 10px;
    margin-left: 4px;
}

.list-add-btn {
    padding: 0 6px;
    margin: 0;
    height: 16px;
    font-size: 13px;
    color: #8f8;
    background-color: #1e3a1e;
    border-color: #2a5a2a;
}

.list-field-content {
    padding: 2px 0 2px 4px;
    background-color: #282828;
}

.list-item-row {
    border-bottom-width: 1px;
    border-bottom-color: #333;
    padding: 1px 0;
}

.list-item-field {
    flex-grow: 1;
}

.list-delete-btn {
    width: 20px;
    padding: 0;
    margin: 2px 2px 0 2px;
    color: #e88;
    background-color: #3a1e1e;
    border-color: #5a2a2a;
    align-self: flex-start;
}

/* ── Subclass selector summary labels ───────────────────────────────── */
.subclass-summary {
    color: #aaa;
    font-size: 10px;
    -unity-font-style: italic;
    padding: 1px 4px 3px 4px;
    margin-left: 2px;
    border-left-width: 2px;
    border-left-color: #555;
}

/* keep file end */
